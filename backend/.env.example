# SQLite by default. Point this at a Postgres URL in production —
# no code changes needed, SQLAlchemy handles the swap.
DATABASE_URL=sqlite:///./livedesk.db

# Shared secret required for any websocket connection claiming role=agent.
# Set this to something real outside local dev — the app falls back to a
# well-known default and prints a warning on startup if you don't.
AGENT_TOKEN=dev-only-agent-token
