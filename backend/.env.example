# "production" makes the app refuse to start with the default AGENT_TOKEN.
APP_ENV=development

# SQLite by default. Point this at a Postgres URL in production — both
# postgres:// and postgresql:// work, no code changes needed.
DATABASE_URL=sqlite:///./livedesk.db

# Shared secret required for role=agent (websocket and agent-only endpoints).
# Outside local dev, set something real: with APP_ENV=production the app
# won't start on the default, and a blank value counts as unset.
AGENT_TOKEN=dev-only-agent-token

# Comma-separated list of frontend origins allowed to call the API.
# Use * to allow any origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
